<Window x:Class="SimpleChdDrive_WinFsp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="SimpleChdDrive (WinFsp)"
        Height="500" Width="800"
        MinHeight="400" MinWidth="640"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource ModernWindowStyle}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Menu Grid.Row="0" Margin="0">
            <MenuItem Header="File" ToolTip="File operations">
                <MenuItem Header="Open CHD..." Click="OpenChd_Click" ToolTip="Select a CHD disc image file to mount" />
                <Separator />
                <MenuItem Header="Exit" Click="Exit_Click" ToolTip="Close the application" />
            </MenuItem>
            <MenuItem Header="Help" ToolTip="Help and information">
                <MenuItem Header="About" Click="About_Click" ToolTip="About SimpleChdDrive" />
            </MenuItem>
        </Menu>

        <Grid Grid.Row="1" Margin="10,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Label Grid.Column="0" Content="CHD File:" VerticalAlignment="Center" />
            <TextBox Grid.Column="1" x:Name="ChdFilePathTextBox" Margin="6,0" VerticalAlignment="Center"
                     TextChanged="ChdFilePath_TextChanged"
                     ToolTip="Path to the CHD disc image file" />
            <Button Grid.Column="2" Content="Browse..." Click="BrowseChd_Click" Width="100" Margin="6,0" ToolTip="Browse for a CHD disc image file" />

            <Label Grid.Column="3" Content="Console:" VerticalAlignment="Center" Margin="12,0,6,0" ToolTip="Select the video game console to parse the disc for" />
            <ComboBox Grid.Column="4" x:Name="ConsoleTypeComboBox" Width="220"
                      VerticalAlignment="Center" SelectionChanged="ConsoleType_SelectionChanged"
                      ToolTip="Select the video game console filesystem type">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Name}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </Grid>

        <Grid Grid.Row="2" Margin="10,0,10,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" x:Name="MountButton" Content="Mount" Width="100"
                    Click="Mount_Click" IsEnabled="False" ToolTip="Mount the CHD file as a virtual drive" />
            <Button Grid.Column="1" x:Name="UnmountButton" Content="Unmount" Width="100"
                    Margin="8,0" IsEnabled="False"
                    Click="Unmount_Click" ToolTip="Unmount the virtual drive" />
        </Grid>

        <TextBox Grid.Row="3" x:Name="LogTextBox"
                 Style="{StaticResource LogTextBoxStyle}"
                 Margin="10,0,10,8" ToolTip="Activity log output" />

        <StatusBar Grid.Row="4" x:Name="StatusBarControl" ToolTip="Application status">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="Ready" />
            </StatusBarItem>
            <Separator Style="{x:Null}" />
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock x:Name="DriveLetterText" Text="" ToolTip="Current mounted drive letter" />
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
