<Window x:Class="SimpleChdDrive_WinFsp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="SimpleChdDrive (WinFsp)"
        Height="500" Width="800"
        MinHeight="400" MinWidth="640"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource ModernWindowStyle}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Menu Grid.Row="0" Margin="0">
            <MenuItem Header="File">
                <MenuItem Header="Open CHD..." Click="OpenChd_Click" />
                <Separator />
                <MenuItem Header="Exit" Click="Exit_Click" />
            </MenuItem>
            <MenuItem Header="Help">
                <MenuItem Header="About" Click="About_Click" />
            </MenuItem>
        </Menu>

        <Grid Grid.Row="1" Margin="10,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Label Grid.Column="0" Content="CHD File:" VerticalAlignment="Center" />
            <TextBox Grid.Column="1" x:Name="ChdFilePathTextBox" Margin="6,0" VerticalAlignment="Center" />
            <Button Grid.Column="2" Content="Browse..." Click="BrowseChd_Click" Width="100" Margin="6,0" />

            <Label Grid.Column="3" Content="Console:" VerticalAlignment="Center" Margin="12,0,6,0" />
            <ComboBox Grid.Column="4" x:Name="ConsoleTypeComboBox" Width="200"
                      VerticalAlignment="Center" />
        </Grid>

        <Grid Grid.Row="2" Margin="10,0,10,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" x:Name="MountButton" Content="Mount" Width="100"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Click="Mount_Click" IsEnabled="False" />
            <Button Grid.Column="1" x:Name="UnmountButton" Content="Unmount" Width="100"
                    Margin="8,0" IsEnabled="False"
                    Click="Unmount_Click" />
        </Grid>

        <TextBox Grid.Row="3" x:Name="LogTextBox"
                 Style="{StaticResource LogTextBoxStyle}"
                 Margin="10,0,10,8" />

        <StatusBar Grid.Row="4" x:Name="StatusBarControl">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="Ready" />
            </StatusBarItem>
            <Separator Style="{x:Null}" />
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock x:Name="DriveLetterText" Text="" />
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
