<Window x:Class="Tester.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:wpfui="clr-namespace:Wpf.Ui.Controls;assembly=Wpf.Ui"
        mc:Ignorable="d"
        Title="Tester - CHD Parsing Test Tool"
        Height="720" Width="1100"
        MinHeight="500" MinWidth="800"
        WindowStartupLocation="CenterScreen"
        KeyDown="MainWindow_KeyDown"
        Closing="MainWindow_Closing"
        Style="{StaticResource ModernWindowStyle}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Menu Grid.Row="0" Margin="0" ToolTip="Application menu bar">
            <MenuItem Header="File" ToolTip="File operations">
                <MenuItem Header="Exit" Click="Exit_Click" ToolTip="Close the application">
                    <MenuItem.Icon>
                        <wpfui:SymbolIcon Symbol="ArrowExit20" />
                    </MenuItem.Icon>
                </MenuItem>
            </MenuItem>
            <MenuItem Header="Help" ToolTip="Help and information">
                <MenuItem Header="Open AppData Folder" Click="OpenAppDataFolder_Click" ToolTip="Open the application data folder in Explorer">
                    <MenuItem.Icon>
                        <wpfui:SymbolIcon Symbol="FolderOpen24" />
                    </MenuItem.Icon>
                </MenuItem>
                <Separator />
                <MenuItem Header="About" Click="About_Click" ToolTip="About Tester">
                    <MenuItem.Icon>
                        <wpfui:SymbolIcon Symbol="Info24" />
                    </MenuItem.Icon>
                </MenuItem>
            </MenuItem>
        </Menu>

        <Border x:Name="UpdateBanner" Grid.Row="1" Background="{StaticResource AccentSecondaryBrush}"
                Visibility="Collapsed" Padding="10,6"
                ToolTip="Notification banner for available application updates">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" x:Name="UpdateBannerText" Foreground="White" FontSize="12"
                           VerticalAlignment="Center"
                           ToolTip="Description of the available update" />
                <Button Grid.Column="1" x:Name="UpdateBannerButton" Content="Download" Width="80" Height="24"
                        Margin="10,0,0,0" Click="UpdateBannerButton_Click"
                        Foreground="White" Background="Transparent" BorderBrush="White" BorderThickness="1"
                        FontSize="11" Cursor="Hand"
                        ToolTip="Download the latest version" />
                <Button Grid.Column="2" Content="X" Width="24" Height="24" Margin="4,0,0,0"
                        Background="Transparent" Foreground="White" BorderThickness="0"
                        FontWeight="Bold" Click="UpdateDismiss_Click" Cursor="Hand"
                        ToolTip="Dismiss this update notification" />
            </Grid>
        </Border>

        <!-- Top Controls -->
        <Border Grid.Row="2" Background="{StaticResource BgSecondaryBrush}"
                BorderBrush="{StaticResource BorderPrimaryBrush}" BorderThickness="0,0,0,1"
                Padding="12,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Label Grid.Column="0" Content="CHD Folder:" VerticalAlignment="Center"
                       Foreground="{StaticResource TextSecondaryBrush}" FontSize="13"
                       ToolTip="Folder containing CHD disc image files to test" />
                <TextBox Grid.Column="1" x:Name="ChdFolderTextBox" Margin="8,0"
                         VerticalAlignment="Center" MinWidth="280"
                         ToolTip="Path to the folder containing CHD disc images to test" />
                <Button Grid.Column="2" x:Name="BrowseButton" Content="Browse..."
                        Width="90" Click="BrowseButton_Click" Margin="0,0,12,0"
                        ToolTip="Browse for a folder containing CHD disc images" />

                <Label Grid.Column="3" Content="Console:" VerticalAlignment="Center"
                       Foreground="{StaticResource TextSecondaryBrush}" FontSize="13"
                       ToolTip="Select the console type to test parsing for" />
                <ComboBox Grid.Column="4" x:Name="ConsoleComboBox" Width="200"
                          VerticalAlignment="Center" Margin="8,0,12,0"
                          ToolTip="Video game console filesystem type to test" />

                <Button Grid.Column="5" x:Name="RunButton" Content="Run Tests"
                        Width="110" Height="32" FontWeight="SemiBold"
                        Click="RunButton_Click" Style="{StaticResource PrimaryButtonStyle}"
                        ToolTip="Run parsing tests on all CHD files in the selected folder" />
                <Button Grid.Column="5" x:Name="CancelButton" Content="Cancel"
                        Width="110" Height="32" FontWeight="SemiBold"
                        Click="CancelButton_Click" Style="{StaticResource PrimaryButtonStyle}"
                        Background="{StaticResource ErrorBrush}"
                        Visibility="Collapsed"
                        ToolTip="Cancel the running test operation" />
            </Grid>
        </Border>

        <!-- Results Summary Panel (collapsed until tests run) -->
        <Border Grid.Row="3" x:Name="SummaryPanel" Background="{StaticResource BgSecondaryBrush}"
                BorderBrush="{StaticResource BorderPrimaryBrush}" BorderThickness="0,0,0,1"
                Padding="12,10" Visibility="Collapsed"
                ToolTip="Summary of test results">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" x:Name="SummaryText" VerticalAlignment="Center"
                           FontSize="14" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           ToolTip="Overall test result summary" />

                <Border Grid.Column="1" x:Name="SuccessBadge" Background="{StaticResource SuccessBrush}"
                        CornerRadius="4" Padding="10,3" Margin="16,0,0,0" VerticalAlignment="Center"
                        ToolTip="Number of successful tests">
                    <TextBlock x:Name="SuccessCountText" Foreground="White" FontWeight="SemiBold" FontSize="13"
                               ToolTip="Count of tests that passed" />
                </Border>

                <Border Grid.Column="1" x:Name="FailBadge" Background="{StaticResource ErrorBrush}"
                        CornerRadius="4" Padding="10,3" Margin="6,0,0,0" VerticalAlignment="Center"
                        ToolTip="Number of failed tests">
                    <TextBlock x:Name="FailCountText" Foreground="White" FontWeight="SemiBold" FontSize="13"
                               ToolTip="Count of tests that failed" />
                </Border>

                <Button Grid.Column="3" x:Name="ExportPdfButton" Content="Export PDF"
                        Width="110" Height="30" Click="ExportPdfButton_Click"
                        Visibility="Collapsed" ToolTip="Export test results to a PDF report" />
            </Grid>
        </Border>

        <!-- Log Area -->
        <Border Grid.Row="4" Margin="0"
                ToolTip="Container for the test output log">
            <RichTextBox x:Name="LogTextBox" IsReadOnly="True"
                         Background="{StaticResource BgPrimaryBrush}"
                         Foreground="{StaticResource TextSecondaryBrush}"
                         FontFamily="{StaticResource MonospaceFontFamily}"
                         FontSize="12"
                         BorderThickness="0"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"
                         ToolTip="Test output log">
                <RichTextBox.Resources>
                    <Style TargetType="Paragraph">
                        <Setter Property="Margin" Value="0" />
                    </Style>
                </RichTextBox.Resources>
            </RichTextBox>
        </Border>

        <!-- Status Bar -->
        <Border Grid.Row="5" Background="{StaticResource BgSecondaryBrush}"
                BorderBrush="{StaticResource BorderPrimaryBrush}" BorderThickness="0,1,0,0"
                Padding="12,4"
                ToolTip="Status bar showing application state and elapsed time">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StatusBar Grid.Column="0" Background="Transparent" Foreground="{StaticResource TextMutedBrush}" ToolTip="Current application status">
                    <StatusBarItem>
                        <TextBlock x:Name="StatusText" Text="Ready" ToolTip="Displays the current status of the application" />
                    </StatusBarItem>
                </StatusBar>

                <TextBlock Grid.Column="1" x:Name="ElapsedText"
                           Foreground="{StaticResource TextMutedBrush}" FontSize="12"
                           ToolTip="Elapsed time since tests started" />
            </Grid>
        </Border>
    </Grid>
</Window>
