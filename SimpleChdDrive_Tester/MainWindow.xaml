<Window x:Class="Tester.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Tester - CHD Parsing Test Tool"
        Height="720" Width="1100"
        MinHeight="500" MinWidth="800"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource ModernWindowStyle}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Top Controls -->
        <Border Grid.Row="0" Background="{StaticResource BgSecondaryBrush}"
                BorderBrush="{StaticResource BorderPrimaryBrush}" BorderThickness="0,0,0,1"
                Padding="12,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Label Grid.Column="0" Content="CHD Folder:" VerticalAlignment="Center"
                       Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" />
                <TextBox Grid.Column="1" x:Name="ChdFolderTextBox" Margin="8,0"
                         VerticalAlignment="Center" MinWidth="280" />
                <Button Grid.Column="2" x:Name="BrowseButton" Content="Browse..."
                        Width="90" Click="BrowseButton_Click" Margin="0,0,12,0" />

                <Label Grid.Column="3" Content="Console:" VerticalAlignment="Center"
                       Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" />
                <ComboBox Grid.Column="4" x:Name="ConsoleComboBox" Width="200"
                          VerticalAlignment="Center" Margin="8,0,12,0" />

                <Button Grid.Column="5" x:Name="RunButton" Content="Run Tests"
                        Width="110" Height="32" FontWeight="SemiBold"
                        Click="RunButton_Click" Style="{StaticResource PrimaryButtonStyle}" />
            </Grid>
        </Border>

        <!-- Results Summary Panel (collapsed until tests run) -->
        <Border Grid.Row="1" x:Name="SummaryPanel" Background="{StaticResource BgSecondaryBrush}"
                BorderBrush="{StaticResource BorderPrimaryBrush}" BorderThickness="0,0,0,1"
                Padding="12,10" Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" x:Name="SummaryText" VerticalAlignment="Center"
                           FontSize="14" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}" />

                <Border Grid.Column="1" x:Name="SuccessBadge" Background="{StaticResource SuccessBrush}"
                        CornerRadius="4" Padding="10,3" Margin="16,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="SuccessCountText" Foreground="White" FontWeight="SemiBold" FontSize="13" />
                </Border>

                <Border Grid.Column="1" x:Name="FailBadge" Background="{StaticResource ErrorBrush}"
                        CornerRadius="4" Padding="10,3" Margin="6,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="FailCountText" Foreground="White" FontWeight="SemiBold" FontSize="13" />
                </Border>

                <Button Grid.Column="3" x:Name="ExportPdfButton" Content="Export PDF"
                        Width="110" Height="30" Click="ExportPdfButton_Click"
                        Visibility="Collapsed" />
            </Grid>
        </Border>

        <!-- Log Area -->
        <Border Grid.Row="2" Margin="0">
            <RichTextBox x:Name="LogTextBox" IsReadOnly="True"
                         Background="{StaticResource BgPrimaryBrush}"
                         Foreground="{StaticResource TextSecondaryBrush}"
                         FontFamily="{StaticResource MonospaceFontFamily}"
                         FontSize="12"
                         BorderThickness="0"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto">
                <RichTextBox.Resources>
                    <Style TargetType="Paragraph">
                        <Setter Property="Margin" Value="0" />
                    </Style>
                </RichTextBox.Resources>
            </RichTextBox>
        </Border>

        <!-- Status Bar -->
        <Border Grid.Row="3" Background="{StaticResource BgSecondaryBrush}"
                BorderBrush="{StaticResource BorderPrimaryBrush}" BorderThickness="0,1,0,0"
                Padding="12,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StatusBar Grid.Column="0" Background="Transparent" Foreground="{StaticResource TextMutedBrush}">
                    <StatusBarItem>
                        <TextBlock x:Name="StatusText" Text="Ready" />
                    </StatusBarItem>
                </StatusBar>

                <TextBlock Grid.Column="1" x:Name="ElapsedText"
                           Foreground="{StaticResource TextMutedBrush}" FontSize="12" />
            </Grid>
        </Border>
    </Grid>
</Window>
