<Window x:Class="CHDMounter.Core.Views.ConsoleSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mount CHD Image" Height="240" Width="500"
        WindowStyle="ToolWindow" ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        Style="{DynamicResource ModernWindowStyle}">
    <Grid Margin="15" ToolTip="Console type selection for CHD image mounting">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Selected CHD image:"
                   Margin="0,0,0,4" FontWeight="SemiBold"
                   ToolTip="Label indicating the selected CHD file" />
        <TextBlock Grid.Row="1" x:Name="ChdPathTextBlock"
                   Margin="0,0,0,10" TextTrimming="CharacterEllipsis"
                   ToolTip="Full path to the CHD disc image file" />

        <TextBlock Grid.Row="2" Text="Select the filesystem type for this CHD image:"
                   Margin="0,0,0,10"
                   ToolTip="Instructions for selecting the console type" />

        <ComboBox Grid.Row="3" x:Name="ConsoleComboBox"
                  Height="35" Margin="0,0,0,15"
                  ToolTip="Select the video game console filesystem type for this CHD image" />

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right"
                    ToolTip="Confirmation buttons">
            <Button Content="Mount" Width="80" Style="{StaticResource PrimaryButtonStyle}"
                    Click="Ok_Click" Margin="0,0,8,0" ToolTip="Mount the CHD image with the selected filesystem type" />
            <Button Content="Cancel" Width="80" Click="Cancel_Click" ToolTip="Cancel and return to main window" />
        </StackPanel>
    </Grid>
</Window>
