<Window x:Class="CHDMounter.Core.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About CHDMounter"
        Height="360" Width="460"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Style="{StaticResource ModernWindowStyle}">
    <Grid Margin="24,20" ToolTip="About window with application information">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" ToolTip="Application name and description">
            <TextBlock Text="CHDMounter" FontSize="22" FontWeight="Bold"
                       Foreground="{StaticResource AccentSecondaryBrush}" ToolTip="Application name" />
            <TextBlock Text="CHD Virtual Drive Mounter" FontSize="13"
                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"
                       ToolTip="Brief description of the application" />
        </StackPanel>

        <Border Grid.Row="1" Height="1" Background="{StaticResource BorderPrimaryBrush}"
                Margin="0,14,0,10" ToolTip="Visual separator" />

        <StackPanel Grid.Row="2" ToolTip="Application details and metadata">
            <Grid Margin="0,0,0,10" ToolTip="Version information">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Version" Foreground="{StaticResource TextMutedBrush}" FontSize="12"
                           ToolTip="Version label" />
                <TextBlock Grid.Column="1" x:Name="VersionText" FontSize="12"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           ToolTip="Current application version number" />
            </Grid>

            <Border x:Name="UpdateBanner" Background="{StaticResource AccentSecondaryBrush}"
                    CornerRadius="4" Padding="10,8" Margin="0,0,0,10" Visibility="Collapsed"
                    ToolTip="Update notification banner">
                <StackPanel>
                    <TextBlock x:Name="UpdateText" Foreground="White" FontSize="12" FontWeight="SemiBold"
                               TextWrapping="Wrap" ToolTip="Update availability message" />
                    <TextBlock x:Name="UpdateLink" Foreground="White" FontSize="12"
                               TextDecorations="Underline" Cursor="Hand" Margin="0,4,0,0"
                               MouseLeftButtonDown="UpdateLink_Click"
                               ToolTip="Click to open the download page" />
                </StackPanel>
            </Border>

            <Grid Margin="0,0,0,10" ToolTip="Framework information">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Framework" Foreground="{StaticResource TextMutedBrush}" FontSize="12"
                           ToolTip="Framework label" />
                <TextBlock Grid.Column="1" Text=".NET 10 / WPF-UI" FontSize="12"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           ToolTip="The UI framework used by this application" />
            </Grid>
            <Grid Margin="0,0,0,10" ToolTip="Supported formats">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Supports" Foreground="{StaticResource TextMutedBrush}" FontSize="12"
                           ToolTip="Supported formats label" />
                <TextBlock Grid.Column="1" FontSize="12"
                           Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap"
                           ToolTip="Disc image formats supported by this application">
                    ISO 9660, UDF, XDVDFS (Xbox), OperaFS (3DO), CD-i Green Book
                </TextBlock>
            </Grid>
            <Grid Margin="0,0,0,10" ToolTip="Company information">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Company" Foreground="{StaticResource TextMutedBrush}" FontSize="12"
                           ToolTip="Company label" />
                <TextBlock Grid.Column="1" Text="PureLogicCode.com" FontSize="12"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           ToolTip="Company or developer website" />
            </Grid>
        </StackPanel>

        <TextBlock Grid.Row="3" Text="Mounts CHD (Compressed Hunks of Data) CD/DVD images as virtual drives using Dokan or WinFsp."
                   TextWrapping="Wrap" FontSize="11" Margin="0,10,0,0"
                   Foreground="{StaticResource TextMutedBrush}"
                   ToolTip="Brief explanation of what the application does" />

        <Button Grid.Row="4" Content="OK" Width="80" HorizontalAlignment="Right"
                Margin="0,14,0,0" Click="Ok_Click" ToolTip="Close the about window" />
    </Grid>
</Window>
