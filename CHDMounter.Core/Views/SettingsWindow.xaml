<Window x:Class="CHDMounter.Core.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings"
        Height="180" Width="380"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Style="{StaticResource ModernWindowStyle}">
    <Grid Margin="24,20" ToolTip="Application settings panel">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Settings" FontSize="18" FontWeight="Bold"
                   Foreground="{StaticResource AccentSecondaryBrush}" Margin="0,0,0,14"
                   ToolTip="Settings window title" />

        <StackPanel Grid.Row="1" ToolTip="Available settings options">
            <CheckBox x:Name="AutoOpenDriveCheckBox" Content="Auto open the mounted drive in Explorer"
                      FontSize="13" Margin="0,0,0,6"
                      ToolTip="When checked, the mounted drive will be opened automatically in File Explorer after mounting." />
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0"
                    ToolTip="Settings action buttons">
            <Button x:Name="CancelButton" Content="Cancel" Width="80"
                    Margin="0,0,10,0" Click="Cancel_Click" ToolTip="Discard changes and close" />
            <Button x:Name="SaveButton" Content="Save" Width="80"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Click="Save_Click" ToolTip="Save settings and close" />
        </StackPanel>
    </Grid>
</Window>
