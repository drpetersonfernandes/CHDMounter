<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <IsPackable>true</IsPackable>
        <NeutralLanguage>en</NeutralLanguage>
        <RootNamespace>SimpleChdDrive.Parsing</RootNamespace>
        <DebugType>embedded</DebugType>
        <DebugSymbols>true</DebugSymbols>
        <AssemblyVersion>1.0.0</AssemblyVersion>
        <FileVersion>1.0.0</FileVersion>
        <Company>PureLogicCode.com</Company>
        <Description>CHD filesystem parsing library for video game console disc images. Supports ISO 9660, UDF, XDVDFS, OperaFS, and CD-i filesystems.</Description>
        <PackageId>SimpleChdDrive.Parsing</PackageId>
        <PackageTags>chd;mame;iso9660;udf;xdvdfs;operafs;cdi;ps1;ps2;ps3;psp;xbox;dreamcast;retro;videogame;disc;filesystem</PackageTags>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <RepositoryUrl>https://github.com/purelogiccode/CSharp_SimpleChdDrive</RepositoryUrl>
    </PropertyGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="SimpleChdDrive" />
        <InternalsVisibleTo Include="SimpleChdDrive_WinFsp" />
        <InternalsVisibleTo Include="SimpleChdDrive.Core.Tests" />
        <InternalsVisibleTo Include="Tester" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="CHDSharp" Version="1.1.0" />
    </ItemGroup>

</Project>
