<Window x:Class="SimpleChdDrive.Core.Views.ConsoleSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Select Filesystem Type" Height="200" Width="400"
        WindowStyle="ToolWindow" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Style="{StaticResource ModernWindowStyle}">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Select the filesystem type for this CHD image:"
                   Margin="0,0,0,10" />

        <ComboBox Grid.Row="1" x:Name="ConsoleComboBox"
                  Height="28" Margin="0,0,0,10"
                  ToolTip="Select the video game console filesystem type for this CHD image" />

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="OK" Width="80" Style="{StaticResource PrimaryButtonStyle}"
                    Click="Ok_Click" Margin="0,0,8,0" ToolTip="Confirm console type selection and mount" />
            <Button Content="Cancel" Width="80" Click="Cancel_Click" ToolTip="Cancel and return to main window" />
        </StackPanel>
    </Grid>
</Window>
