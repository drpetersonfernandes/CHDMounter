<Window x:Class="SimpleChdDrive.Core.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About SimpleChdDrive" Height="260" Width="420"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Style="{StaticResource ModernWindowStyle}">
    <Grid Margin="20">
        <StackPanel>
            <TextBlock Text="SimpleChdDrive" FontSize="20" FontWeight="Bold" Margin="0,0,0,8" />
            <TextBlock Text="CHD Virtual Drive Mounter" FontSize="14"
                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,20" />
            <TextBlock Text="Version 1.0.0" Margin="0,0,0,5" />
            <TextBlock Text="Mounts CHD (Compressed Hunks of Data) CD/DVD images as virtual drives."
                       TextWrapping="Wrap" Margin="0,0,0,10" />
            <TextBlock Text="Supported filesystems: ISO 9660, UDF, XDVDFS (Xbox), OperaFS (3DO), CD-i Green Book"
                       TextWrapping="Wrap" Margin="0,0,0,10"
                       Foreground="{StaticResource TextMutedBrush}" />
            <TextBlock Text="Uses Dokan or WinFsp for virtual filesystem mounting." Margin="0,0,0,10"
                       Foreground="{StaticResource TextMutedBrush}" />
            <Button Content="OK" Width="80" HorizontalAlignment="Right"
                    Style="{StaticResource PrimaryButtonStyle}" Click="Ok_Click" />
        </StackPanel>
    </Grid>
</Window>
